{
  "manifest_version": 3,
  "name": "GH PR Jira Key Link",
  "version": "1.0.0",
  "description": "Turns Jira issue keys in GitHub PR titles into links to your Jira",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://github.com/*/*/pull/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Configure Jira host"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
